# Copy this file to .env for local development.
# On Render, DATABASE_URL is injected automatically — do not set it manually there.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apex_talent
PORT=3000

# Set to "disable" only for local Postgres instances that don't use SSL.
# Leave unset (or anything other than "disable") in production/Render.
PGSSL=disable

# Secret used to sign admin/staff JWTs. Generate a real one with:
#   openssl rand -hex 32
# Never reuse this example value or commit a real secret to source control.
JWT_SECRET=replace-this-with-a-real-random-secret

# One-time secret that unlocks POST /api/auth/bootstrap-admin, for creating
# your first staff_admin account without shell/SSH access (needed on
# Render's free tier, which doesn't support Shell). On Render this is
# auto-generated (see render.yaml). Locally, set your own random value.
ADMIN_BOOTSTRAP_SECRET=replace-this-with-a-real-random-secret
