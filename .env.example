# Copy this file to .env for local development.
# On Render, DATABASE_URL is injected automatically — do not set it manually there.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apex_talent
PORT=3000

# Set to "disable" only for local Postgres instances that don't use SSL.
# Leave unset (or anything other than "disable") in production/Render.
PGSSL=disable
